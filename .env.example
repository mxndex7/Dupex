# Copie para .env e ajuste. Gere a chave com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# Sem DUPEX_SECRET_KEY a API gera uma chave temporária a cada start (os tokens expiram ao reiniciar).
# Em produção, defina sempre.
DUPEX_SECRET_KEY=

# Padrão: SQLite em ./data/dupex.db
# DUPEX_DATABASE_URL=sqlite:///./data/dupex.db

# Minutos de validade do token de acesso
# DUPEX_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Desligue para fechar o cadastro depois de criar os usuários
# DUPEX_ALLOW_REGISTRATION=true

# Aplica as migrações ao iniciar. Com false, rode `alembic upgrade head` manualmente.
# DUPEX_AUTO_MIGRATE=true

# Origens permitidas para CORS (JSON). Vazio = CORS desligado.
# DUPEX_CORS_ORIGINS=["http://localhost:3000"]
